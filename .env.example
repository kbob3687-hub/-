AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
# 公开投稿必须启用审核（不受 IS_OFFLINE_DEMO 影响）。
# 配置支持 image_url 图片输入和 JSON 输出的视觉模型；不配置或失败时暂停公开入库。
# 审核接口为 /chat/completions；空 key/base 时复用 AI_API_KEY / AI_BASE_URL。
CONTENT_REVIEW_BASE_URL=
CONTENT_REVIEW_API_KEY=
CONTENT_REVIEW_MODEL=
# 支持 thinking 参数的服务可关闭思考，避免审核 JSON 被输出预算截断。
CONTENT_REVIEW_DISABLE_THINKING=false
# 人物开放联想使用同一模型接口；模型提供的来源链接会标为待核对线索。
IS_OFFLINE_DEMO=true
NEXT_PUBLIC_PUBLIC_URL=
